# HousingMind RAG System Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI Model for generation
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo-preview

# Optional: Vector database path
# Default: ./vector_db
VECTOR_DB_PATH=./vector_db

# Optional: Embedding model
# Default: text-embedding-3-large
# Options: text-embedding-3-large, text-embedding-3-small, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-large
