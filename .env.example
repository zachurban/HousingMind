# HousingMind RAG System Configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
# ---------------------
# Ollama host URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Ollama model for text generation
# Options: llama3.1:8b-instruct-q8_0, llama3.1:8b, llama3.1:70b, etc.
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0

# Embedding Configuration
# -----------------------
# Device for running embeddings ('cpu', 'cuda', 'mps')
EMBEDDING_DEVICE=cpu

# Embedding model (default: BAAI/bge-large-en-v1.5)
# Other options: BAAI/bge-base-en-v1.5, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Vector Database
# ---------------
# Path to vector database storage
VECTOR_DB_PATH=./vector_db

# Optional: OpenAI API Key (for fallback or comparison)
# OPENAI_API_KEY=your-openai-api-key-here
